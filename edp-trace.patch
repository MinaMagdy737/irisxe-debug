+++ b/WhateverXe/kern_edp_trace.hpp
@@ -0,0 +1,30 @@
+// Diagnostic CPU storage only. No IO, allocation, pointers or logging here.
+#ifndef WEX_EDP_TRACE_HPP
+#define WEX_EDP_TRACE_HPP
+#include <stdint.h>
+namespace WEXEDPTrace {
+struct Row { uint32_t id,kind; uint64_t actual,expected; };
+struct Capture {
+ uint32_t version,count,overflow,rowBytes;
+ Row rows[384];
+ void put(uint32_t id,uint32_t kind,uint64_t actual,uint64_t expected) {
+  if(count<384)rows[count++]={id,kind,actual,expected};else ++overflow;
+ }
+};
+inline void init(Capture *trace) {
+ if(trace){trace->version=1;trace->count=trace->overflow=0;trace->rowBytes=sizeof(Row);}
+}
+inline bool good(Capture *trace,uint32_t id,bool value) {
+ if(trace)trace->put(id,0,value,1);return value;
+}
+inline bool equal(Capture *trace,uint32_t id,uint64_t actual,uint64_t expected) {
+ if(trace)trace->put(id,0,actual,expected);return actual==expected;
+}
+inline bool atLeast(Capture *trace,uint32_t id,uint64_t actual,uint64_t expected) {
+ if(trace)trace->put(id,2,actual,expected);return actual>=expected;
+}
+inline void observed(Capture *trace,uint32_t id,uint64_t value) {
+ if(trace)trace->put(id,1,value,0);
+}
+}
+#endif
